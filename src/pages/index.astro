---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const writeups = await getCollection('writeups');
const methodologies = await getCollection('methodologies');
const cheatsheets = await getCollection('cheatsheets');

// Sort writeups by date
const recentWriteups = writeups
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Sort methodologies by order
const sortedMethodologies = methodologies
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout title="Dashboard" currentActive="home">
  <!-- Terminal Welcome Header -->
  <section class="terminal-welcome cyber-card" style="margin-bottom: 2rem;">
    <div class="terminal-bar">
      <span class="dot red-dot"></span>
      <span class="dot yellow-dot"></span>
      <span class="dot green-dot"></span>
      <span class="terminal-title">vapt-kb@b00g3ym4n:~</span>
    </div>
    <div class="terminal-content">
      <h1 class="glow-cyan">&gt; INITIALIZING VAPT_KNOWLEDGE_BASE...</h1>
      <p class="mono-text">Welcome to the central command dashboard. Here you will find vulnerability assessment methodologies, detailed penetration testing writeups (HackTheBox & TryHackMe), and quick-copy exploit cheat sheets.</p>
      <div class="system-status">
        <span class="status-item"><span class="pulse-green"></span> DB_STATUS: ONLINE</span>
        <span class="status-item"><span class="pulse-cyan"></span> SECURE_SHELL: ACTIVE</span>
      </div>
    </div>
  </section>

  <!-- Statistics Counter Grid -->
  <section class="stat-grid">
    <div class="cyber-card stat-card">
      <span class="badge badge-info">WRITEUPS</span>
      <div class="stat-val glow-cyan">{writeups.length}</div>
      <p style="font-size: 0.8rem; margin-top: 0.5rem;" class="mono">ROOMS COMPLETED</p>
    </div>
    <div class="cyber-card stat-card">
      <span class="badge badge-purple">GUIDES</span>
      <div class="stat-val" style="color: var(--color-purple); text-shadow: 0 0 10px rgba(176,38,255,0.4);">{methodologies.length}</div>
      <p style="font-size: 0.8rem; margin-top: 0.5rem;" class="mono">METHODOLOGIES</p>
    </div>
    <div class="cyber-card stat-card">
      <span class="badge badge-success">SHELLS</span>
      <div class="stat-val glow-green">{cheatsheets.length}</div>
      <p style="font-size: 0.8rem; margin-top: 0.5rem;" class="mono">EXPL_CHEATSHEETS</p>
    </div>
  </section>

  <!-- Main Dashboard Columns -->
  <div class="dashboard-grid">
    <!-- Left Hand Column: Recent Writeups -->
    <div class="recent-writeups-section">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="font-family: var(--font-mono); font-size: 1.5rem; color: var(--color-cyan);" class="glow-cyan">
          [//] RECENT_LOGS
        </h2>
        <a href={`${import.meta.env.BASE_URL}writeups`} class="terminal-btn">VIEW_ALL_LOGS &gt;</a>
      </div>

      <div class="cards-list">
        {recentWriteups.length > 0 ? (
          recentWriteups.map((w) => (
            <div style="margin-bottom: 1.5rem;">
              <Card 
                title={w.data.title} 
                href={`${import.meta.env.BASE_URL}writeups/${w.slug}`} 
                category={w.data.platform} 
                date={w.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                badgeType={w.data.platform === 'HackTheBox' ? 'success' : 'info'}
              >
                <p style="margin-bottom: 0.8rem;">{w.data.description}</p>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  {w.data.tags.map((tag) => (
                    <span class="tag-badge">#{tag}</span>
                  ))}
                </div>
              </Card>
            </div>
          ))
        ) : (
          <p class="mono text-muted">No writeups posted yet.</p>
        )}
      </div>
    </div>

    <!-- Right Hand Column: Methodologies & Cheatsheets -->
    <div class="quick-links-section">
      <h2 style="font-family: var(--font-mono); font-size: 1.5rem; color: var(--color-cyan); margin-bottom: 1.5rem;" class="glow-cyan">
        [//] RECON_&_GUIDES
      </h2>

      <!-- Methodologies Card -->
      <div class="cyber-card" style="margin-bottom: 1.5rem;">
        <h3 style="font-family: var(--font-mono); color: var(--color-purple); font-size: 1.1rem; margin-bottom: 1rem;">
          SYSTEM_METHODOLOGIES
        </h3>
        <ul style="list-style: none;">
          {sortedMethodologies.map((m) => (
            <li class="guide-item">
              <a href={`${import.meta.env.BASE_URL}methodologies/${m.slug}`} class="guide-link">
                <span class="prompt">&gt;</span> {m.data.title}
              </a>
              <span class="mono-badge">{m.data.phase}</span>
            </li>
          ))}
        </ul>
        <a href={`${import.meta.env.BASE_URL}methodologies`} class="terminal-btn" style="width: 100%; justify-content: center; margin-top: 1rem;">
          ALL_METHODOLOGIES &gt;
        </a>
      </div>

      <!-- Quick Commands Card -->
      <div class="cyber-card">
        <h3 style="font-family: var(--font-mono); color: var(--color-green); font-size: 1.1rem; margin-bottom: 1rem;">
          QUICK_COMMANDS
        </h3>
        <p style="font-size: 0.85rem; margin-bottom: 1rem; color: var(--text-secondary);">
          Instant access to critical payloads and exploits.
        </p>
        <ul style="list-style: none;">
          {cheatsheets.map((c) => (
            <li class="guide-item" style="border-color: rgba(57, 255, 20, 0.15);">
              <a href={`${import.meta.env.BASE_URL}cheatsheets`} class="guide-link" style="color: var(--text-primary);">
                <span class="prompt" style="color: var(--color-green);">&gt;</span> {c.data.title}
              </a>
              <span class="badge badge-success" style="font-size: 0.65rem;">{c.data.category}</span>
            </li>
          ))}
        </ul>
        <a href={`${import.meta.env.BASE_URL}cheatsheets`} class="terminal-btn" style="width: 100%; justify-content: center; margin-top: 1rem; border-color: var(--color-green); color: var(--color-green);">
          ALL_CHEATSHEETS &gt;
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Terminal Welcome Card Styling */
  .terminal-bar {
    display: flex;
    gap: 0.4rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 1rem;
    align-items: center;
  }
  
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  
  .red-dot { background: #ff5f56; }
  .yellow-dot { background: #ffbd2e; }
  .green-dot { background: #27c93f; }
  
  .terminal-title {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  
  .mono-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .system-status {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  
  .status-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  
  .pulse-green {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 6px var(--color-green);
  }
  
  .pulse-cyan {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 6px var(--color-cyan);
  }
  
  .tag-badge {
    background: rgba(15, 23, 42, 0.35);
    border: 1px dashed var(--border-color);
    color: var(--text-secondary);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }
  
  /* Sidebar guide list item styling */
  .guide-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border-color);
  }
  
  .guide-item:last-child {
    border-bottom: none;
  }
  
  .guide-link {
    font-family: var(--font-mono);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  
  .guide-link:hover {
    color: var(--color-cyan);
    padding-left: 4px;
  }
  
  .prompt {
    color: var(--color-purple);
    font-weight: bold;
    margin-right: 0.3rem;
  }
  
  .mono-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }
</style>
